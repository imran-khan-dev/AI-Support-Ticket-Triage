
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=
GROQ_BASE_URL=

# Agent execution limits
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_MAX_MEMORY_ITEMS=3
AGENT_MAX_MEMORY_CHARS=1200

# Approver token secret for approval workflow credentials
APPROVER_TOKEN_SECRET=your_approver_token_secret_here

# PostgreSQL connection string for session, message, approval, and audit storage.
# Create the database first, for example: createdb ticket_triage
# The schema is applied automatically on the first request that needs it.
DATABASE_URL=postgresql://user:password@localhost:5432/ticket_triage
